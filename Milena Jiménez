    <script>

        /* =====================================================
           ENTRADA
        ===================================================== */

        const entrada =
            document.getElementById("entrada");

        const botonEntrar =
            document.getElementById("entrar");


        botonEntrar.addEventListener(
            "click",
            function () {

                entrada.classList.add("salir");

            }
        );


        /* =====================================================
           MOVIMIENTO DEL UNIVERSO
        ===================================================== */

        const universo =
            document.getElementById("universo");


        let x = 0;

        let y = 0;

        let escala = .55;


        /* =====================================================
           ACTUALIZAR
        ===================================================== */

        function actualizar() {

            universo.style.transform =

                `translate(
            calc(-50% + ${x}px),
            calc(-50% + ${y}px)
        )
        scale(${escala})`;

        }


        /* =====================================================
           MOUSE
        ===================================================== */

        let arrastrando = false;

        let inicioX = 0;

        let inicioY = 0;


        document.addEventListener(
            "mousedown",
            function (e) {

                arrastrando = true;

                inicioX =
                    e.clientX - x;

                inicioY =
                    e.clientY - y;

            }
        );


        document.addEventListener(
            "mousemove",
            function (e) {

                if (!arrastrando)
                    return;

                x =
                    e.clientX - inicioX;

                y =
                    e.clientY - inicioY;

                actualizar();

            }
        );


        document.addEventListener(
            "mouseup",
            function () {

                arrastrando = false;

            }
        );


        /* =====================================================
           ZOOM
        ===================================================== */

        document.addEventListener(
            "wheel",
            function (e) {

                e.preventDefault();


                if (e.deltaY < 0) {

                    escala += .07;

                }
                else {

                    escala -= .07;

                }


                escala =
                    Math.max(
                        .35,
                        Math.min(
                            2.5,
                            escala
                        )
                    );


                actualizar();

            },
            {
                passive: false
            }
        );


        /* =====================================================
           TOUCH
        ===================================================== */

        let touchX = 0;

        let touchY = 0;

        let distanciaInicial = 0;


        document.addEventListener(
            "touchstart",
            function (e) {

                if (e.touches.length === 1) {

                    touchX =
                        e.touches[0].clientX - x;

                    touchY =
                        e.touches[0].clientY - y;

                }


                if (e.touches.length === 2) {

                    distanciaInicial =
                        distancia(
                            e.touches[0],
                            e.touches[1]
                        );

                }

            },
            {
                passive: false
            }
        );


        document.addEventListener(
            "touchmove",
            function (e) {

                e.preventDefault();


                if (e.touches.length === 1) {

                    x =
                        e.touches[0].clientX - touchX;

                    y =
                        e.touches[0].clientY - touchY;

                    actualizar();

                }


                if (e.touches.length === 2) {

                    const nuevaDistancia =
                        distancia(
                            e.touches[0],
                            e.touches[1]
                        );


                    escala +=

                        (
                            nuevaDistancia -
                            distanciaInicial
                        ) * .002;


                    escala =
                        Math.max(
                            .35,
                            Math.min(
                                2.5,
                                escala
                            )
                        );


                    distanciaInicial =
                        nuevaDistancia;


                    actualizar();

                }

            },
            {
                passive: false
            }
        );


        /* =====================================================
           CALCULAR DISTANCIA
        ===================================================== */

        function distancia(a, b) {

            const dx =
                a.clientX -
                b.clientX;

            const dy =
                a.clientY -
                b.clientY;

            return Math.sqrt(
                dx * dx +
                dy * dy
            );

        }


        /* =====================================================
           DOBLE CLICK = RESTAURAR
        ===================================================== */

        document.addEventListener(
            "dblclick",
            function () {

                x = 0;

                y = 0;

                escala = .55;

                actualizar();

            }
        );


        actualizar();

    </script>

